<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.4.1">
  <diagram name="三算法对比">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="620">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="投机解码三算法对比:MTP(NEXTN) vs DFlash vs DSpark" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="MTP / NEXTN(EAGLE worker 驱动)" style="swimlane;startSize=32;fillColor=#f8f8f8;strokeColor=#666666;fontSize=13;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="390" height="550" as="geometry" />
        </mxCell>
        <mxCell id="a_t" value="目标模型&#xa;(MTP 头与其同 checkpoint 训练)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="laneA">
          <mxGeometry x="95" y="50" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a_d" value="Draft = MTP 头&#xa;(目标 checkpoint 自带,1 层)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="laneA">
          <mxGeometry x="95" y="200" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a_kv" value="Draft KV(全长)&#xa;draft 自己前向算出的 K/V" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;boundedLbl=1;" vertex="1" parent="laneA">
