        </mxCell>
        <mxCell id="a_note" value="draft:γ 次自回归小步(串行)&#xa;verify:定长 bs×(γ+1)&#xa;接受同步:draft_extend 重算前向写 KV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="laneA">
          <mxGeometry x="35" y="440" width="320" height="80" as="geometry" />
